{
  "tasks": {
    "dev": "deno run -A npm:vite dev",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "imports": {
    "@sveltejs/adapter-auto": "npm:@sveltejs/adapter-auto@^7.0.1",
    "@sveltejs/kit": "npm:@sveltejs/kit@^2.55.0",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.0.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.2.2",
    "chart.js": "npm:chart.js@^4.5.1",
    "chartjs-adapter-dayjs-4": "npm:chartjs-adapter-dayjs-4@^1.0.4",
    "chartjs-plugin-zoom": "npm:chartjs-plugin-zoom@^2.2.0",
    "dayjs": "npm:dayjs@^1.11.20",
    "svelte": "npm:svelte@^5.55.1",
    "svelte-chartjs": "npm:svelte-chartjs@^4.0.1",
    "tailwindcss": "npm:tailwindcss@^4.2.2",
    "vite": "npm:vite@^8.0.3"
  }
}
