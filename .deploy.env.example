# Copy to .deploy.env (gitignored) and fill in your Pi's details.

# SSH target — Tailscale MagicDNS name preferred so you can deploy from anywhere
PI_HOST=your-pi.your-tailnet.ts.net
PI_USER=alex

# Where the app lives on the Pi (cache file lands here too)
PI_DIR=/home/alex/burndown

# Port the SvelteKit server binds on inside the Pi (loopback only)
APP_PORT=3000

# Port tailscale serve exposes on the tailnet. Use 8443 to avoid conflicting
# with any existing funnel/serve on 443. If you want :443, change here AND
# update ORIGIN to drop the :8443 suffix.
SERVE_PORT=8443

# Public-facing origin SvelteKit emits in cookies/redirects. Must match what
# users hit in their browser. Tailscale gives you https://<host>.<tailnet>.ts.net.
ORIGIN=https://your-pi.your-tailnet.ts.net:8443
